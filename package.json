{
  "name": "sally-chrome-extension",
  "version": "1.0.0",
  "license": "AGPL-3.0-only",
  "description": "Sally by HeySalad® - AI Shopping Assistant Chrome Extension",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:qr": "jest tests/qr-functionality.test.js"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "setupFilesAfterEnv": ["<rootDir>/tests/setup.js"],
    "collectCoverageFrom": [
      "popup/**/*.js",
      "!popup/qrcode.min.js",
      "!**/node_modules/**"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 70,
        "functions": 70,
        "lines": 70,
        "statements": 70
      }
    }
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2"
  }
}
