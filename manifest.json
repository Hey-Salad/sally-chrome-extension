{
  "manifest_version": 3,
  "name": "Sally by HeySalad®",
  "short_name": "Sally by HeySalad®",
  "version": "1.0.28",
  "description": "Save time on repeat shopping. Chat with Sally to plan lists, build carts, and run shopping tasks.",
  "author": "HeySalad Payments Ltd",
  "homepage_url": "https://heysalad.app",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Sally by HeySalad®"
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs",
    "tabGroups",
    "notifications",
    "identity",
    "sidePanel"
  ],
  "host_permissions": [
    "https://www.tesco.com/*",
    "https://secure.tesco.com/*",
    "https://www.sainsburys.co.uk/*",
    "https://groceries.asda.com/*",
    "https://www.ocado.com/*",
    "https://www.waitrose.com/*",
    "https://groceries.morrisons.com/*",
    "https://www.morrisons.com/*",
    "https://www.aldi.co.uk/*",
    "https://oauth.heysalad.app/*",
    "https://shopping-agent.heysalad-o.workers.dev/*",
    "https://sally-api.heysalad.app/*",
    "https://sally-api.heysalad-o.workers.dev/*",
    "wss://sally-api.heysalad-o.workers.dev/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.tesco.com/*",
        "https://secure.tesco.com/*",
        "https://www.sainsburys.co.uk/*",
        "https://groceries.asda.com/*",
        "https://www.ocado.com/*",
        "https://www.waitrose.com/*",
        "https://groceries.morrisons.com/*",
        "https://www.morrisons.com/*",
        "https://www.aldi.co.uk/*"
      ],
      "js": [
        "shared/task-metrics.js",
        "shared/item-parser.js",
        "shared/product-fit.js",
        "shared/product-language.js",
        "content-scripts/base.js"
      ],
      "css": [
        "content-scripts/overlay.css"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://chat.heysalad.app/*",
        "https://heysalad.app/*",
        "https://sally.heysalad.app/*"
      ],
      "exclude_matches": [
        "https://www.tesco.com/*",
        "https://secure.tesco.com/*",
        "https://www.sainsburys.co.uk/*",
        "https://groceries.asda.com/*",
        "https://www.ocado.com/*",
        "https://www.waitrose.com/*",
        "https://groceries.morrisons.com/*",
        "https://www.morrisons.com/*",
        "https://www.aldi.co.uk/*"
      ],
      "js": [
        "shared/item-parser.js",
        "content-scripts/recipe-detector.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*",
        "popup/qrcode.min.js"
      ],
      "matches": [
        "https://www.tesco.com/*",
        "https://secure.tesco.com/*",
        "https://www.sainsburys.co.uk/*",
        "https://groceries.asda.com/*",
        "https://www.ocado.com/*",
        "https://www.waitrose.com/*",
        "https://groceries.morrisons.com/*",
        "https://www.morrisons.com/*",
        "https://www.aldi.co.uk/*",
        "https://chat.heysalad.app/*",
        "https://heysalad.app/*",
        "https://sally.heysalad.app/*"
      ]
    }
  ]
}
